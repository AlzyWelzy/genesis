# Keeps the build context small and, more importantly, keeps secrets and local
# state out of the image. Anything copied in is readable by anyone who pulls it.

.git
.github
.venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov

# Secrets — never in an image
.env
.env.*
!.env.example
keys/
*.pem

# Local state
var/
*.db
*.sqlite3

# Not needed at runtime
tests/
docs/
scripts/
compose.yaml
Dockerfile
.dockerignore
.editorconfig
.pre-commit-config.yaml
# README.md is deliberately NOT excluded. pyproject.toml declares it as the
# package's long description, so the build backend reads it when the production
# stage installs the project; excluding it turns `uv sync` into a build failure
# that only reproduces inside Docker.
