# Editor-agnostic formatting, so a contributor's IDE defaults cannot introduce
# whitespace-only diffs. Ruff owns Python formatting; this covers everything
# else and the settings Ruff cannot enforce (final newline, trailing whitespace).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
