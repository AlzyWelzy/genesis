# Copy to .env and adjust. Nested settings use a double underscore:
# `DATABASE__URL` populates Settings.database.url.
#
# Only DATABASE__URL is required; everything else has a default that is safe
# for local development.
#
# Never commit a real .env. In deployment, prefer file-per-secret mounts:
# set SECRETS_DIR=/run/secrets and the same fields are read from files.
# See docs/architecture/configuration.md

# --- Application -----------------------------------------------------------
APP__NAME=Genesis
APP__VERSION=0.1.0
# local | test | development | staging | production
APP__ENVIRONMENT=local
APP__DEBUG=true
APP__ENABLE_DOCS=true
APP__API_PREFIX=/api
APP__API_VERSION=v1
# JSON array. Never ["*"] together with credentials.
APP__CORS_ORIGINS=["http://localhost:3000"]
# Required in production; guards against Host-header poisoning.
APP__TRUSTED_HOSTS=[]

# --- Database (required) ---------------------------------------------------
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genesis
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=10
DATABASE__STATEMENT_TIMEOUT_MS=30000
# DATABASE__READ_REPLICA_URL=

# --- JWT -------------------------------------------------------------------
# Generate the key pair: uv run python scripts/generate_keys.py
JWT__ALGORITHM=EdDSA
JWT__PRIVATE_KEY_PATH=keys/private.pem
JWT__PUBLIC_KEY_PATH=keys/public.pem
# Published as the `kid` header; change on rotation.
JWT__ACTIVE_KEY_ID=primary
# Retired public keys still accepted for verification and served from JWKS.
JWT__RETIRED_KEYS_DIR=keys/retired
JWT__ISSUER=genesis
JWT__AUDIENCE=genesis-api
# Short by design: an access token cannot be revoked, so its lifetime is the
# revocation window.
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Security policy -------------------------------------------------------
# Length is the only password rule with strong evidence behind it (NIST 800-63B).
SECURITY__PASSWORD_MIN_LENGTH=12
SECURITY__PASSWORD_MAX_LENGTH=128
SECURITY__PASSWORD_REQUIRE_UPPERCASE=false
SECURITY__PASSWORD_REQUIRE_DIGIT=false
SECURITY__PASSWORD_REQUIRE_SYMBOL=false
SECURITY__PASSWORD_CHECK_BREACHED=true
SECURITY__MAX_FAILED_LOGIN_ATTEMPTS=10
SECURITY__LOCKOUT_DURATION_MINUTES=15

# --- Rate limiting ---------------------------------------------------------
# Off locally; required in production.
RATE_LIMIT__ENABLED=false
RATE_LIMIT__ANONYMOUS_PER_MINUTE=60
RATE_LIMIT__AUTHENTICATED_PER_MINUTE=600
RATE_LIMIT__WINDOW_SECONDS=60
# Allow requests through when Redis is unreachable.
RATE_LIMIT__FAIL_OPEN=true

# --- Redis -----------------------------------------------------------------
REDIS__URL=redis://localhost:6379/0
REDIS__KEY_PREFIX=genesis
REDIS__DEFAULT_TTL_SECONDS=300
REDIS__MAX_CONNECTIONS=20

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE__PROVIDER=local
STORAGE__LOCAL_ROOT=var/storage
STORAGE__MAX_UPLOAD_BYTES=10485760
# STORAGE__BUCKET=
# STORAGE__REGION=
# STORAGE__ENDPOINT_URL=
# STORAGE__ACCESS_KEY_ID=
# STORAGE__SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------
# console | smtp — console is the default so a misconfigured dev box cannot
# mail real customers.
EMAIL__PROVIDER=console
EMAIL__FROM_ADDRESS=no-reply@example.com
EMAIL__FROM_NAME=Genesis
# EMAIL__SMTP_HOST=
# EMAIL__SMTP_PORT=587
# EMAIL__SMTP_USERNAME=
# EMAIL__SMTP_PASSWORD=

# --- Logging ---------------------------------------------------------------
LOGGING__LEVEL=INFO
# Required in production — unparseable logs are unsearchable during an incident.
LOGGING__JSON_FORMAT=false
LOGGING__ACCESS_LOG=true
# Development only: bodies contain passwords, tokens and personal data.
LOGGING__LOG_REQUEST_BODY=false

# --- Observability ---------------------------------------------------------
OBSERVABILITY__METRICS_ENABLED=false
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__SERVICE_NAME=genesis-api
OBSERVABILITY__TRACE_SAMPLE_RATE=0.1
# OBSERVABILITY__OTLP_ENDPOINT=
# OBSERVABILITY__SENTRY_DSN=
