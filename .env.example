# Copy to .env and adjust. Nested settings use a double underscore:
# `DATABASE__URL` populates Settings.database.url.
#
# Only DATABASE__URL is required; every other value has a default.
# Never commit a real .env — secrets belong in a secret manager.

# --- Application -----------------------------------------------------------
APP__NAME=Genesis
APP__VERSION=0.1.0
APP__ENVIRONMENT=local
APP__DEBUG=true
APP__API_PREFIX=/api
# JSON array. Never use ["*"] together with credentials.
APP__CORS_ORIGINS=["http://localhost:3000"]

# --- Database (required) ---------------------------------------------------
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genesis
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=10

# --- JWT -------------------------------------------------------------------
# Generate the key pair: uv run python scripts/generate_keys.py
JWT__ALGORITHM=EdDSA
JWT__PRIVATE_KEY_PATH=keys/private.pem
JWT__PUBLIC_KEY_PATH=keys/public.pem
JWT__ISSUER=genesis
JWT__AUDIENCE=genesis-api
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Redis -----------------------------------------------------------------
REDIS__URL=redis://localhost:6379/0
REDIS__KEY_PREFIX=genesis
REDIS__DEFAULT_TTL_SECONDS=300

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE__PROVIDER=local
STORAGE__LOCAL_ROOT=var/storage
# STORAGE__BUCKET=
# STORAGE__REGION=
# STORAGE__ENDPOINT_URL=
# STORAGE__ACCESS_KEY_ID=
# STORAGE__SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------
# console | smtp — console is the default so a misconfigured dev box cannot
# mail real customers.
EMAIL__PROVIDER=console
EMAIL__FROM_ADDRESS=no-reply@example.com
EMAIL__FROM_NAME=Genesis
# EMAIL__SMTP_HOST=
# EMAIL__SMTP_PORT=587
# EMAIL__SMTP_USERNAME=
# EMAIL__SMTP_PASSWORD=

# --- Logging ---------------------------------------------------------------
LOGGING__LEVEL=INFO
# Enable in any environment with a log aggregator.
LOGGING__JSON_FORMAT=false
LOGGING__ACCESS_LOG=true
