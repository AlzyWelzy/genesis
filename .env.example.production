# Reference values for a production deployment. NOT loaded automatically —
# `.env.<environment>` overlays are, so the deployed file would be named
# `.env.production`. This file documents what a safe production config looks
# like; the values themselves must come from a secret manager.
#
# The settings validator refuses to start if any of these are wrong. That is
# deliberate: a misconfigured instance that crashes is a failed deploy, while
# one that starts is an exposure.

APP__ENVIRONMENT=production
APP__DEBUG=false
APP__ENABLE_DOCS=false
APP__CORS_ORIGINS=["https://app.example.com"]
APP__TRUSTED_HOSTS=["api.example.com"]

LOGGING__JSON_FORMAT=true
LOGGING__LOG_REQUEST_BODY=false
LOGGING__LEVEL=INFO

RATE_LIMIT__ENABLED=true

DATABASE__ECHO=false
DATABASE__POOL_SIZE=20

OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__TRACING_ENABLED=true

# Secrets arrive as mounted files, not environment variables:
#   SECRETS_DIR=/run/secrets
# containing database__url, jwt__private_key_path, email__smtp_password, ...
